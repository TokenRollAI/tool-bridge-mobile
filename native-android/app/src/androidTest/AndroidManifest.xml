<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- AGP injects the variant's runner attributes into the first instrumentation element. -->
    <instrumentation android:name="androidx.test.runner.AndroidJUnitRunner" />
    <instrumentation
        android:name="ai.tokenroll.toolbridge.mobile.RemoteControlInstrumentation"
        android:targetPackage="ai.tokenroll.toolbridgemobile.dev" />
    <application>
        <activity
            android:name="ai.tokenroll.toolbridge.mobile.ControlTargetActivity"
            android:exported="true"
            android:label="远控测试便签"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
