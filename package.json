{
  "name": "tool-bridge-mobile",
  "private": true,
  "version": "0.0.4",
  "type": "module",
  "main": "index.js",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "22.23.1"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "prebuild:android": "expo prebuild --clean --platform android",
    "prebuild:ios": "expo prebuild --clean --platform ios",
    "build:android:debug": "NODE_ENV=development pnpm prebuild:android && cd android && NODE_ENV=development ./gradlew assembleDebug",
    "build:android:preview": "APP_VARIANT=preview NODE_ENV=production pnpm prebuild:android && cd android && NODE_ENV=production ./gradlew assembleRelease",
    "build:ios:sim": "NODE_ENV=development pnpm prebuild:ios && NODE_ENV=development xcodebuild -workspace ios/ToolBridgeMobileDev.xcworkspace -scheme ToolBridgeMobileDev -configuration Debug -sdk iphonesimulator CODE_SIGNING_ALLOWED=NO build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "jest --runInBand",
    "test:contract": "jest --runInBand --testPathPatterns=contract",
    "audit:dependencies": "pnpm audit --prod --audit-level high",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:config": "node scripts/verify-app-config.mjs",
    "verify:dependency-mitigations": "node scripts/verify-dependency-mitigations.mjs",
    "verify:android:emulator": "node scripts/verify-android-emulator.mjs",
    "verify:doctor": "expo-doctor",
    "verify:expo": "expo install --check",
    "verify:licenses": "node scripts/verify-licenses.mjs",
    "verify:native-modules": "node scripts/verify-native-modules.mjs",
    "verify:release-tag": "node scripts/verify-release-tag.mjs",
    "verify:sdk-device": "node scripts/verify-sdk-device-entry.mjs",
    "verify:secrets": "node scripts/verify-secrets.mjs",
    "verify": "pnpm verify:docs && pnpm verify:release-tag && pnpm verify:config && pnpm verify:native-modules && pnpm verify:sdk-device && pnpm verify:secrets && pnpm verify:licenses && pnpm verify:dependency-mitigations && pnpm verify:expo && pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@tool-bridge/sdk": "0.11.0",
    "expo": "57.0.14",
    "expo-application": "57.0.2",
    "expo-asset": "57.0.12",
    "expo-audio": "57.0.3",
    "expo-battery": "57.0.2",
    "expo-build-properties": "57.0.12",
    "expo-constants": "57.0.12",
    "expo-crypto": "57.0.1",
    "expo-dev-client": "57.0.13",
    "expo-device": "57.0.1",
    "expo-file-system": "57.0.4",
    "expo-linking": "57.0.6",
    "expo-location": "57.0.11",
    "expo-network": "57.0.1",
    "expo-notifications": "57.0.12",
    "expo-router": "57.0.14",
    "expo-secure-store": "57.0.1",
    "expo-sqlite": "57.0.1",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.2",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.1",
    "expo-doctor": "1.20.2",
    "image-size": "1.2.1",
    "jest": "29.7.0",
    "jest-expo": "57.0.4",
    "test-renderer": "1.2.0",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|(jest-)?react-native|@react-native(-community)?|@tool-bridge/sdk|partysocket|event-target-polyfill|expo(nent)?|@expo(nent)?/.*|expo-router|react-navigation|@react-navigation/.*|react-native-safe-area-context|react-native-screens))"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/"
    ]
  }
}
