# 非秘密构建变量。开发环境也不得在 EXPO_PUBLIC_* 中放置设备凭证或 push token。
APP_VARIANT=development
# 可选的非秘密 Gateway HTTPS origin 预置；首页本机配置优先。API key/SK 只能由 UI 写入 SecureStore。
EXPO_PUBLIC_GATEWAY_ORIGIN=https://gateway.example.com
# 允许交给系统浏览器/App 的精确 HTTPS hostname；空值表示 handoff 能力不可用。
EXPO_PUBLIC_LINK_HOSTS=www.example.com
# 逗号分隔的媒体 CDN hostname；不含 scheme/path，空值表示远程媒体能力不可用。
EXPO_PUBLIC_MEDIA_HOSTS=media.example.com
